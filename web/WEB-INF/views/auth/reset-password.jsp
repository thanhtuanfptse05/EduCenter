<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><%@ include file="/WEB-INF/views/common/head.jspf" %></head><body class="public-site"><%@ include file="/WEB-INF/views/common/public-header.jspf" %><main id="main-content" class="screen-wrap auth-screen"><section class="screen-card screen-stack"><%@ include file="/WEB-INF/views/common/alert.jsp" %>
<div class="screen-heading"><span class="screen-eyebrow">Khôi phục truy cập</span><h1>Đặt mật khẩu mới</h1></div><c:choose><c:when test="${resetState.valid}"><p class="screen-muted" data-reset-seconds="${resetState.remainingSeconds}">Liên kết còn hiệu lực: <strong id="reset-time-left"></strong></p><form action="${pageContext.request.contextPath}/reset-password" method="post" class="screen-stack" data-reset-form><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="token" value="<c:out value='${token}'/>"/>
<label class="screen-field">Mật khẩu mới<input name="newPassword" type="password" required minlength="6" autocomplete="new-password"/></label><p class="screen-muted">Ít nhất 6 ký tự, tối đa 72 byte UTF-8.</p><label class="screen-field">Xác nhận mật khẩu<input name="confirmNewPassword" type="password" required minlength="6" autocomplete="new-password"/></label><p class="screen-muted">Sau khi đặt lại mật khẩu, các phiên đăng nhập cũ sẽ hết hiệu lực.</p><button class="btn btn-primary" type="submit">Lưu mật khẩu mới</button></form></c:when><c:otherwise><p class="screen-warning">Liên kết không hợp lệ, đã hết hạn hoặc đã được sử dụng.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/forgot-password">Yêu cầu liên kết mới</a></c:otherwise></c:choose></section></main><%@ include file="/WEB-INF/views/common/public-footer.jspf" %></body></html>