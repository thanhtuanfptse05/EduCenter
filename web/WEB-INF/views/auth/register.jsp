<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><%@ include file="/WEB-INF/views/common/head.jspf" %></head><body class="public-site"><%@ include file="/WEB-INF/views/common/public-header.jspf" %><main id="main-content" class="screen-wrap auth-screen"><section class="screen-card screen-stack"><%@ include file="/WEB-INF/views/common/alert.jsp" %>
<div class="screen-heading"><span class="screen-eyebrow">Tham gia EduCenter</span><h1>Tạo tài khoản</h1><p>Chọn tài khoản học sinh hoặc phụ huynh để bắt đầu.</p></div>
<form action="${pageContext.request.contextPath}/register" method="post" class="screen-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/>
<label class="screen-field">Vai trò<select name="roleCode"><option value="STUDENT" ${sessionScope.preserved_roleCode == 'STUDENT' ? 'selected' : ''}>Học sinh</option><option value="PARENT" ${sessionScope.preserved_roleCode == 'PARENT' ? 'selected' : ''}>Phụ huynh</option></select></label>
<label class="screen-field">Họ và tên<input name="fullName" required minlength="2" maxlength="150" autocomplete="name" value="<c:out value='${sessionScope.preserved_fullName}'/>"/></label>
<label class="screen-field">Số điện thoại<input name="phone" type="tel" required maxlength="20" autocomplete="tel" value="<c:out value='${sessionScope.preserved_phone}'/>"/></label>
<label class="screen-field">Email<input name="email" type="email" required maxlength="255" autocomplete="username" value="<c:out value='${sessionScope.preserved_email}'/>"/></label>
<label class="screen-field">Mật khẩu<input name="password" type="password" required minlength="6" autocomplete="new-password" aria-describedby="password-rule"/></label><p class="screen-muted" id="password-rule">Ít nhất 6 ký tự, tối đa 72 byte UTF-8.</p>
<label class="screen-field">Xác nhận mật khẩu<input name="confirmPassword" type="password" required minlength="6" autocomplete="new-password"/></label><button class="btn btn-primary" type="submit">Tạo tài khoản</button></form><p>Đã có tài khoản? <a href="${pageContext.request.contextPath}/login">Đăng nhập</a></p>
<c:remove var="preserved_fullName" scope="session"/><c:remove var="preserved_phone" scope="session"/><c:remove var="preserved_email" scope="session"/><c:remove var="preserved_roleCode" scope="session"/></section></main><%@ include file="/WEB-INF/views/common/public-footer.jspf" %></body></html>