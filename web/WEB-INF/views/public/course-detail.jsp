<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><%@ include file="/WEB-INF/views/common/head.jspf" %></head>
<body class="public-site"><c:set var="activeNav" value="courses" scope="request"/><%@ include file="/WEB-INF/views/common/public-header.jspf" %>
<main id="main-content" class="screen-wrap"><%@ include file="/WEB-INF/views/common/alert.jsp" %>
<nav class="screen-steps" aria-label="Đường dẫn"><a href="${pageContext.request.contextPath}/">Trang chủ</a><span>/</span><a href="${pageContext.request.contextPath}/courses">Khóa học</a><span>/</span><c:out value="${detail.course.code}"/></nav>
<div class="screen-heading"><span class="screen-eyebrow"><c:out value="${detail.course.subjectName}"/> · Lớp <c:out value="${detail.course.gradeLevel}"/></span><h1><c:out value="${detail.course.name}"/></h1></div>
<div class="screen-columns"><div class="screen-stack">
 <c:if test="${not empty detail.course.imageUrl}"><img class="screen-course-image" src="<c:url value='${detail.course.imageUrl}'/>" alt="<c:out value='${detail.course.name}'/>"/></c:if>
 <section class="screen-card"><h2>Giới thiệu khóa học</h2><c:choose><c:when test="${not empty detail.course.description}"><p class="screen-notes"><c:out value="${detail.course.description}"/></p></c:when><c:otherwise><p class="screen-muted">Nội dung chi tiết chưa được công bố. Bạn có thể gửi yêu cầu tư vấn để tìm hiểu chương trình.</p></c:otherwise></c:choose></section>
 <c:if test="${not empty detail.primaryTeacher}"><section class="screen-card"><h2>Giáo viên phụ trách</h2><strong><c:out value="${detail.primaryTeacher.fullName}"/></strong><p class="screen-muted"><c:out value="${detail.primaryTeacher.degree}"/></p><p><c:out value="${detail.primaryTeacher.bio}"/></p></section></c:if>
 <section class="screen-card"><h2>Lớp đang tuyển sinh</h2><c:choose><c:when test="${empty detail.openClasses}"><p class="screen-muted">Chưa có lớp mở cho khóa này. Lịch tuyển sinh sẽ được cập nhật khi có phân công mới.</p></c:when><c:otherwise><div class="screen-table-wrap"><table class="screen-table"><thead><tr><th>Lớp / Giáo viên</th><th>Buổi sắp tới / Phòng</th><th>Sĩ số</th><th>Lựa chọn</th></tr></thead><tbody>
 <c:forEach var="cl" items="${detail.openClasses}"><tr><td><strong><c:out value="${cl.code}"/></strong><p><c:out value="${cl.name}"/></p><span class="screen-muted"><c:out value="${empty cl.teacherName ? 'Chưa phân công giáo viên' : cl.teacherName}"/></span></td><td><p><c:out value="${empty cl.scheduleText ? 'Chưa công bố lịch học' : cl.scheduleText}"/></p><span class="screen-muted"><c:out value="${empty cl.roomName ? 'Chưa phân phòng' : cl.roomName}"/></span></td><td><c:out value="${cl.enrolledCount}"/>/<c:out value="${cl.capacity}"/><p class="screen-muted">Còn <c:out value="${cl.remainingSlots}"/> chỗ</p></td><td><c:choose><c:when test="${cl.remainingSlots > 0 and detail.course.openForRegistration}"><form action="${pageContext.request.contextPath}/registration-cart/add" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="courseId" value="${detail.course.id}"/><input type="hidden" name="notes" value="Ưu tiên lớp <c:out value='${cl.code}'/>"/><button type="submit" class="btn btn-secondary btn-sm">Đăng ký tư vấn lớp</button></form></c:when><c:otherwise><span class="screen-muted">Chưa nhận đăng ký</span></c:otherwise></c:choose></td></tr></c:forEach>
 </tbody></table></div></c:otherwise></c:choose></section>
</div><aside class="screen-card screen-stack"><h2>Thông tin đăng ký</h2><div class="screen-price"><c:out value="${detail.course.formattedFee}"/></div><p class="screen-muted">Học phí niêm yết cho toàn khóa</p><div><p><c:out value="${detail.course.totalSessions}"/> buổi học</p><p><c:out value="${detail.course.durationWeeks}"/> tuần</p><p>Tối đa <c:out value="${detail.course.maxCapacity}"/> học viên/lớp</p></div>
<c:choose><c:when test="${detail.course.openForRegistration}"><span class="status-pill status-active">Đang tuyển sinh</span><form action="${pageContext.request.contextPath}/registration-cart/add" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="courseId" value="${detail.course.id}"/><button type="submit" class="btn btn-primary btn-block">Thêm vào danh sách đăng ký</button></form></c:when><c:otherwise><p class="screen-warning">Khóa học hiện chưa nhận đăng ký.</p></c:otherwise></c:choose>
<p class="screen-muted">Danh sách đăng ký là yêu cầu tư vấn. Việc xếp lớp được xác nhận sau khi tiếp nhận nhu cầu.</p><a class="btn btn-secondary" href="${pageContext.request.contextPath}/courses">Xem các khóa học khác</a></aside></div>
<c:if test="${not empty detail.relatedCourses}"><section class="screen-heading"><h2>Khóa học cùng môn hoặc khối lớp</h2><div class="screen-course-grid"><c:forEach var="rc" items="${detail.relatedCourses}"><article class="screen-card"><h3><a href="${pageContext.request.contextPath}/courses/detail?id=${rc.id}"><c:out value="${rc.name}"/></a></h3><p class="screen-muted"><c:out value="${rc.subjectName}"/> · Lớp <c:out value="${rc.gradeLevel}"/></p><p class="screen-price"><c:out value="${rc.formattedFee}"/></p></article></c:forEach></div></section></c:if>
</main><%@ include file="/WEB-INF/views/common/public-footer.jspf" %></body></html>
