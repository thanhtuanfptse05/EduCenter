<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><%@ include file="/WEB-INF/views/common/head.jspf" %></head>
<body class="public-site"><c:set var="activeNav" value="courses" scope="request"/><%@ include file="/WEB-INF/views/common/public-header.jspf" %>
<main id="main-content" class="screen-wrap"><%@ include file="/WEB-INF/views/common/alert.jsp" %>
<div class="screen-heading"><span class="screen-eyebrow">Đăng ký khóa học</span><h1>Danh sách của bạn</h1><p>Kiểm tra khóa học, ghi chú nguyện vọng và học phí niêm yết trước khi gửi yêu cầu tư vấn.</p></div>
<c:choose><c:when test="${empty cart.items}"><div class="screen-card screen-empty"><h2>Bạn chưa chọn khóa học nào</h2><p>Khám phá danh mục và thêm những chương trình bạn quan tâm vào danh sách đăng ký.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/courses">Khám phá khóa học</a></div></c:when><c:otherwise>
<div class="screen-columns"><div class="screen-stack"><c:forEach var="item" items="${cart.items}"><article class="screen-card screen-stack"><div class="screen-row"><div><span class="screen-muted"><c:out value="${item.courseCode}"/> · <c:out value="${item.subjectName}"/></span><h2><a href="${pageContext.request.contextPath}/courses/detail?id=${item.courseId}"><c:out value="${item.courseName}"/></a></h2></div><form action="${pageContext.request.contextPath}/registration-cart/remove" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="courseId" value="${item.courseId}"/><button class="btn btn-secondary btn-sm" type="submit">Xóa</button></form></div>
<c:choose><c:when test="${item.available}"><div class="screen-row"><span>Học phí niêm yết</span><strong><c:out value="${item.formattedFee}"/></strong></div></c:when><c:otherwise><p class="screen-warning">Khóa học này không còn mở đăng ký hoặc chưa công bố học phí. Vui lòng xóa khỏi danh sách trước khi xác nhận.</p></c:otherwise></c:choose>
<form class="screen-stack" action="${pageContext.request.contextPath}/registration-cart/update" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><input type="hidden" name="courseId" value="${item.courseId}"/><label class="screen-field" for="notes-${item.courseId}">Ghi chú / Lịch học mong muốn<textarea id="notes-${item.courseId}" name="notes" maxlength="500" rows="2"><c:out value="${item.notes}"/></textarea></label><div><button class="btn btn-secondary btn-sm" type="submit">Lưu ghi chú</button></div></form></article></c:forEach>
<div class="screen-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/courses">Chọn thêm khóa học</a><form action="${pageContext.request.contextPath}/registration-cart/clear" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"/><button class="btn btn-ghost" type="submit">Làm trống danh sách</button></form></div></div>
<aside class="screen-card screen-stack"><h2>Tóm tắt đăng ký</h2><div class="screen-row"><span>Số khóa đã chọn</span><strong><c:out value="${cart.totalCourses}"/></strong></div><div><p class="screen-muted">Tổng học phí các khóa đang mở</p><p class="screen-price"><c:out value="${cart.formattedTotalFee}"/></p></div><p class="screen-muted">Học phí được cập nhật từ thông tin khóa học hiện tại. Yêu cầu này chưa phát sinh thanh toán hoặc ghi danh chính thức.</p><c:choose><c:when test="${cart.checkoutReady}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/registration/confirm">Tiếp tục đăng ký</a></c:when><c:otherwise><p class="screen-warning">Cần cập nhật khóa học không còn nhận đăng ký.</p></c:otherwise></c:choose></aside></div>
</c:otherwise></c:choose>
</main><%@ include file="/WEB-INF/views/common/public-footer.jspf" %></body></html>
