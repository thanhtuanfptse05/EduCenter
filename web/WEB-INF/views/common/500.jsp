<%@ page contentType="text/html;charset=UTF-8" language="java" isErrorPage="true" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="500 — EduCenter" scope="request"/>
<!DOCTYPE html><html lang="vi"><head><%@ include file="/WEB-INF/views/common/head.jspf" %></head><body class="public-site">
<%@ include file="/WEB-INF/views/common/public-header.jspf" %><main id="main-content" class="screen-wrap"><section class="screen-card screen-empty"><span class="screen-eyebrow">HTTP 500</span><h1>Chưa thể hoàn thành yêu cầu</h1><p>Hệ thống đang gặp sự cố. Vui lòng thử lại sau hoặc gửi mã tham chiếu khi liên hệ hỗ trợ.</p>
<c:if test="${not empty incidentReference}"><div class="screen-card"><p>Mã tham chiếu: <strong><c:out value="${incidentReference}"/></strong></p><p>Ghi nhận: <c:out value="${incidentTime}"/> (GMT+7)</p></div></c:if><div class="screen-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/">Về trang chủ</a><a class="btn btn-secondary" href="${pageContext.request.contextPath}/courses">Xem khóa học</a></div></section></main><%@ include file="/WEB-INF/views/common/public-footer.jspf" %></body></html>