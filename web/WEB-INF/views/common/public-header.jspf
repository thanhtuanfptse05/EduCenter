<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<header class="public-nav-header">
    <div class="public-nav-container">
        <!-- Logo & Brand -->
        <div class="public-nav-brand-wrap">
            <a href="${pageContext.request.contextPath}/" class="public-brand-link">
                <div class="public-brand-logo-box">
                    <svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true" style="color: #ffffff;">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </div>
                <div class="public-brand-text">
                    <span class="public-brand-name">EduCenter</span>
                </div>
            </a>
            <span class="public-brand-pill">THPT &amp; Đào Tạo</span>
        </div>

        <!-- Center Navigation Links -->
        <nav class="public-nav-links">
            <a href="${pageContext.request.contextPath}/" class="public-nav-item ${activeNav == 'home' ? 'active' : ''}">Trang chủ</a>
            <a href="${pageContext.request.contextPath}/courses" class="public-nav-item ${activeNav == 'courses' ? 'active' : ''}">Danh mục khóa học</a>
            <a href="${pageContext.request.contextPath}/#doi-ngu" class="public-nav-item">Đội ngũ gia sư</a>
            <a href="${pageContext.request.contextPath}/#hoc-phi" class="public-nav-item">Học phí &amp; Lịch học</a>
            <a href="${pageContext.request.contextPath}/#tu-van" class="public-nav-item">Tư vấn tuyển sinh</a>
        </nav>

        <!-- Right Side Utility Actions -->
        <div class="public-nav-actions">
            <!-- Registration Cart Icon with Real Count Badge -->
            <a href="${pageContext.request.contextPath}/registration-cart" class="cart-btn-link" title="Danh sách khóa học đã chọn">
                <svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <c:if test="${cartCount != null && cartCount > 0}">
                    <span class="cart-badge-count"><c:out value="${cartCount}" /></span>
                </c:if>
            </a>

            <!-- Theme Toggle Button -->
            <button type="button" class="theme-toggle-btn" data-theme-toggle aria-label="Chuyển chế độ sáng/tối" title="Chuyển chế độ sáng/tối">
                <svg class="icon icon-md theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="display: none;">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
                <svg class="icon icon-md theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                </svg>
            </button>

            <div class="nav-actions-sep"></div>

            <c:choose>
                <c:when test="${not empty sessionScope.currentUser}">
                    <a href="${pageContext.request.contextPath}/profile" class="user-profile-nav-link" title="Xem hồ sơ">
                        <span class="user-nav-avatar">
                            <c:out value="${sessionScope.currentUser.fullName != null && !sessionScope.currentUser.fullName.isEmpty() ? sessionScope.currentUser.fullName.substring(0, 1).toUpperCase() : 'U'}" />
                        </span>
                        <span class="user-nav-name"><c:out value="${sessionScope.currentUser.fullName}" /></span>
                    </a>
                    <a href="${pageContext.request.contextPath}/logout" class="btn btn-secondary btn-sm" title="Đăng xuất">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </a>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/login" class="nav-login-link">Đăng nhập</a>
                    <a href="${pageContext.request.contextPath}/register" class="btn btn-primary btn-sm">Đăng ký</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
