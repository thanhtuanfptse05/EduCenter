<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a class="site-skip" href="#main-content">Đến nội dung chính</a>
<header class="site-header" data-shared-public-header>
  <div class="site-header-inner">
    <a href="${pageContext.request.contextPath}/" class="site-brand" aria-label="EduCenter — Trang chủ">
      <span class="site-brand-symbol"><svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true"><path d="m2 10 10-5 10 5-10 5zM6 12v5c3 3 9 3 12 0v-5M22 10v6"/></svg></span>
      <span>EduCenter</span>
    </a>
    <nav class="site-links" aria-label="Điều hướng chính">
      <a class="site-link" href="${pageContext.request.contextPath}/" aria-current="${activeNav == 'home' ? 'page' : 'false'}">Trang chủ</a>
      <a class="site-link" href="${pageContext.request.contextPath}/courses" aria-current="${activeNav == 'courses' ? 'page' : 'false'}">Khóa học</a>
      <a class="site-link" href="${pageContext.request.contextPath}/#thanh-tuu">Thành tựu</a>
      <a class="site-link" href="${pageContext.request.contextPath}/#lo-trinh-hoc-tap">Lộ trình</a>
      <a class="site-link" href="${pageContext.request.contextPath}/#chuong-trinh">Chương trình</a>
      <a class="site-link" href="${pageContext.request.contextPath}/#mon-hoc">Môn học</a>
      <a class="site-link" href="${pageContext.request.contextPath}/#doi-ngu">Giáo viên</a>
      <a class="site-link" href="${pageContext.request.contextPath}/#dang-ky-tu-van">Tư vấn</a>
    </nav>
    <div class="site-actions">
      <a href="${pageContext.request.contextPath}/registration-cart" class="site-icon" aria-label="Giỏ đăng ký khóa học">
        <svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h2l2.4 12h11.2L21 6H6M9 20h.01M18 20h.01"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
        <c:if test="${not empty cartCount and cartCount > 0}"><span class="site-cart-count" aria-label="Số khóa đã chọn"><c:out value="${cartCount}"/></span></c:if>
      </a>
      <button type="button" class="site-icon" data-theme-toggle aria-label="Chuyển chế độ sáng/tối">
        <svg class="icon icon-md theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="icon icon-md theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1 1M18 18l1 1M5 19l1-1M18 6l1-1"/></svg>
      </button>
      <c:choose><c:when test="${not empty sessionScope.currentUser}">
        <a class="site-link site-user" href="${pageContext.request.contextPath}/profile"><c:out value="${sessionScope.currentUser.fullName}"/></a>
        <a class="btn btn-secondary btn-sm site-desktop-action" href="${pageContext.request.contextPath}${sessionScope.currentUser.defaultDashboardUrl}">Không gian của tôi</a>
      </c:when><c:otherwise>
        <a class="site-link site-desktop-action" href="${pageContext.request.contextPath}/login">Đăng nhập</a>
        <a class="btn btn-primary btn-sm site-desktop-action" href="${pageContext.request.contextPath}/#dang-ky-tu-van">Đăng ký tư vấn</a>
      </c:otherwise></c:choose>
      <button type="button" class="site-icon site-menu-button" data-site-menu aria-controls="site-mobile-menu" aria-expanded="false" aria-label="Mở menu điều hướng"><svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    </div>
  </div>
  <nav id="site-mobile-menu" class="site-mobile-nav" aria-label="Điều hướng di động" hidden>
    <a href="${pageContext.request.contextPath}/">Trang chủ</a><a href="${pageContext.request.contextPath}/courses">Khóa học</a>
    <a href="${pageContext.request.contextPath}/#thanh-tuu">Thành tựu</a><a href="${pageContext.request.contextPath}/#lo-trinh-hoc-tap">Lộ trình</a>
    <a href="${pageContext.request.contextPath}/#chuong-trinh">Chương trình</a><a href="${pageContext.request.contextPath}/#mon-hoc">Môn học</a>
    <a href="${pageContext.request.contextPath}/#doi-ngu">Giáo viên</a><a href="${pageContext.request.contextPath}/#dang-ky-tu-van">Đăng ký tư vấn</a>
    <c:choose><c:when test="${not empty sessionScope.currentUser}"><a href="${pageContext.request.contextPath}${sessionScope.currentUser.defaultDashboardUrl}">Không gian của tôi</a><a href="${pageContext.request.contextPath}/profile">Hồ sơ cá nhân</a><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></c:when>
    <c:otherwise><a href="${pageContext.request.contextPath}/login">Đăng nhập</a><a href="${pageContext.request.contextPath}/register">Đăng ký tài khoản</a></c:otherwise></c:choose>
</header>
<script>
(function () {
  try {
    var h = window.location.hash;
    if (h && h.length > 1) {
      var links = document.querySelectorAll('.site-links .site-link, #site-mobile-menu a');
      links.forEach(function (a) {
        var href = a.getAttribute('href') || '';
        if (href.endsWith(h) || href === h) {
          a.setAttribute('aria-current', 'page');
        } else if (a.getAttribute('aria-current') === 'page') {
          a.setAttribute('aria-current', 'false');
        }
      });
    }
  } catch (e) {}
})();
</script>
