<c:choose><c:when test="${internalShell}">
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<button type="button" class="app-drawer-backdrop" data-drawer-backdrop aria-label="Đóng menu" hidden></button>
<header class="admin-topbar app-header">
<button type="button" class="site-icon app-menu-button" data-app-menu aria-controls="app-sidebar" aria-expanded="false" aria-label="Mở menu nội bộ"><svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    <div class="topbar-left app-header-nav">
        <a href="${pageContext.request.contextPath}/" class="app-brand">
            <span class="app-brand-badge-box">
                <svg class="icon icon-md" viewBox="0 0 24 24" aria-hidden="true" style="color: #ffffff;">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
            </span>
            <span>EduCenter</span>
            <span class="app-brand-badge">THPT Tutoring</span>
        </a>
        <c:choose>
            <c:when test="${not empty breadcrumb}">
                <span style="color: var(--border);">/</span>
                <span style="color: var(--text-muted); font-size: var(--font-size-sm); font-weight: 500;"><c:out value="${breadcrumb}" /></span>
            </c:when>
            <c:otherwise>
                <a href="${pageContext.request.contextPath}/" class="app-header-link" style="margin-left: 8px;">Về trang chủ</a>
            </c:otherwise>
        </c:choose>
    </div>

    <div class="topbar-right app-header-actions">
        <!-- Theme Toggle Button with Lucide Sun/Moon SVG icons per design.md -->
        <button type="button" class="btn btn-ghost btn-sm" data-theme-toggle aria-label="Chuyển chế độ sáng/tối" title="Chuyển chế độ sáng/tối">
            <svg class="icon icon-md theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" style="display: none;">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="icon icon-md theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
        </button>

        <c:choose>
            <c:when test="${not empty sessionScope.currentUser}">
                <div class="app-user-actions" style="display: flex; align-items: center; gap: 8px;">
                    <a href="${pageContext.request.contextPath}/profile" class="btn btn-ghost btn-sm" style="display: flex; align-items: center; gap: 8px; padding: 4px 10px 4px 6px; border-radius: var(--radius-md);" title="Xem hồ sơ">
                        <span class="header-user-avatar" style="width: 28px; height: 28px; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--primary-subtle); border: 1px solid var(--border);">
                            <c:choose>
                                <c:when test="${not empty sessionScope.currentUser.avatarUrl}">
                                    <img src="<c:url value='${sessionScope.currentUser.avatarUrl}' />" alt="" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                                    <span style="display: none; font-size: 12px; font-weight: 700; color: var(--primary);"><c:out value="${sessionScope.currentUser.fullName != null && !sessionScope.currentUser.fullName.isEmpty() ? sessionScope.currentUser.fullName.substring(0, 1).toUpperCase() : 'U'}" /></span>
                                </c:when>
                                <c:otherwise>
                                    <span style="font-size: 12px; font-weight: 700; color: var(--primary);"><c:out value="${sessionScope.currentUser.fullName != null && !sessionScope.currentUser.fullName.isEmpty() ? sessionScope.currentUser.fullName.substring(0, 1).toUpperCase() : 'U'}" /></span>
                                </c:otherwise>
                            </c:choose>
                        </span>
                        <span class="app-user-name" style="font-weight: 600;"><c:out value="${sessionScope.currentUser.fullName}" /></span>
                        <span class="badge badge-admin app-user-role" style="font-size: 10px; padding: 2px 6px;">
                            <c:out value="${sessionScope.currentUser.primaryRole}" />
                        </span>
                    </a>
                    <a href="${pageContext.request.contextPath}/logout" class="btn btn-secondary btn-sm" title="Đăng xuất">
                        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span class="app-logout-label">Đăng xuất</span>
                    </a>
                </div>
            </c:when>
            <c:otherwise>
                <a href="${pageContext.request.contextPath}/login" class="btn btn-ghost btn-sm">Đăng nhập</a>
                <a href="${pageContext.request.contextPath}/register" class="btn btn-primary btn-sm">Đăng ký</a>
            </c:otherwise>
        </c:choose>
    </div>
</header>

</c:when><c:otherwise><%@ include file="/WEB-INF/views/common/public-header.jspf" %></c:otherwise></c:choose>
