<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><c:out value="${pageTitle != null ? pageTitle : 'EduCenter — Hệ Thống Quản Trị Trung Tâm Gia Sư & Luyện Thi'}" /></title>

<!-- Pre-CSS Theme Execution: Strictly enforces default light mode per design.md -->
<script>
(function () {
  var theme = 'light';
  try {
    if (localStorage.getItem('educenter-theme') === 'dark') {
      theme = 'dark';
    }
  } catch (e) {}
  document.documentElement.setAttribute('data-theme', theme);
})();
</script>

<!-- Inter Font -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Local Stylesheets -->
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/tokens.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/base.css">
