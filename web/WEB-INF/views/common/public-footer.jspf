<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<footer class="site-footer" id="lien-he" role="contentinfo">
  <div class="site-footer-inner">
    <c:if test="${referenceDataUnavailable}">
      <div class="alert alert-warning mb-4" role="status">
        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Chưa tải được một số dữ liệu danh mục bổ trợ. Hệ thống đang hiển thị thông tin tiêu chuẩn trung tâm.</span>
      </div>
    </c:if>

    <!-- Top Brand & Contact Row -->
    <div class="site-footer-top-brand">
      <div class="site-footer-brand-info">
        <a href="${pageContext.request.contextPath}/" class="site-footer-brand-header" aria-label="EduCenter — Trang chủ">
          <div class="site-footer-brand-logo">E</div>
          <div>
            <div class="site-footer-brand-title">EduCenter</div>
            <span class="site-footer-brand-sub">THPT Tutoring &amp; ERP Platform</span>
          </div>
        </a>
        <p class="site-footer-brand-desc">
          Hệ thống đào tạo, bồi dưỡng kiến thức và luyện thi THPT Quốc Gia chuẩn hóa mô hình phân quyền tác nghiệp (RBAC). Đồng hành cùng học viên xây dựng nền tảng vững chắc và bứt phá điểm số vào các trường đại học hàng đầu.
        </p>
        <div class="site-footer-badges">
          <span class="site-footer-badge" title="Tiêu chuẩn an toàn thông tin quốc tế">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            ISO/IEC 27001
          </span>
          <span class="site-footer-badge" title="Khung chương trình chuẩn Bộ GD&ĐT">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            Chuẩn GDPT 2018
          </span>
          <span class="site-footer-badge" title="Bảo mật đường truyền 256-bit">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Mã hóa TLS 1.3
          </span>
        </div>
      </div>

      <div class="site-footer-contact-cards">
        <div class="site-footer-contact-item">
          <div class="site-footer-contact-label">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Tổng đài tuyển sinh
          </div>
          <div class="site-footer-contact-value">1900 6886</div>
          <div class="site-footer-contact-detail">Phục vụ 08:00 – 21:30 hàng ngày</div>
        </div>

        <div class="site-footer-contact-item">
          <div class="site-footer-contact-label">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Thư điện tử hỗ trợ
          </div>
          <div class="site-footer-contact-value">hotro@educenter.vn</div>
          <div class="site-footer-contact-detail">Phản hồi hồ sơ trong 2 giờ làm việc</div>
        </div>

        <div class="site-footer-contact-item">
          <div class="site-footer-contact-label">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Cơ sở 1 (Hà Nội)
          </div>
          <div class="site-footer-contact-value">Khu CNC Hòa Lạc / Cầu Giấy</div>
          <div class="site-footer-contact-detail">Phòng học tiêu chuẩn &amp; Phòng lab thực hành</div>
        </div>

        <div class="site-footer-contact-item">
          <div class="site-footer-contact-label">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Cơ sở 2 (TP. Hồ Chí Minh)
          </div>
          <div class="site-footer-contact-value">Đường D1, Khu CNC, TP. Thủ Đức</div>
          <div class="site-footer-contact-detail">Không gian học tập chuyên sâu THPT &amp; ĐGNL</div>
        </div>
      </div>
    </div>

    <!-- 4 Navigation Columns -->
    <div class="site-footer-nav-grid">
      <!-- Col 1 -->
      <div class="site-footer-nav-col">
        <h3>
          <svg class="icon icon-sm text-primary" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/></svg>
          Chương trình đào tạo
        </h3>
        <ul>
          <li><a href="${pageContext.request.contextPath}/courses">Luyện thi THPT Quốc Gia (Toán, Lý, Hóa)</a></li>
          <li><a href="${pageContext.request.contextPath}/courses">Bổ trợ kiến thức Lớp 10, 11, 12</a></li>
          <li><a href="${pageContext.request.contextPath}/courses">Luyện thi Đánh Giá Năng Lực (ĐHQG / ĐHBK)</a></li>
          <li><a href="${pageContext.request.contextPath}/courses">Tiếng Anh &amp; Luyện đề chuyên sâu</a></li>
          <li><a href="${pageContext.request.contextPath}/#lo-trinh-hoc-tap">Lộ trình bứt phá 4 giai đoạn</a></li>
        </ul>
      </div>

      <!-- Col 2 -->
      <div class="site-footer-nav-col">
        <h3>
          <svg class="icon icon-sm text-primary" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Học viên &amp; Phụ huynh
        </h3>
        <ul>
          <li><a href="${pageContext.request.contextPath}/courses">Tra cứu &amp; Tìm kiếm khóa học</a></li>
          <li><a href="${pageContext.request.contextPath}/registration-cart">Danh sách khóa học đã chọn</a></li>
          <li><a href="${pageContext.request.contextPath}/#dang-ky-tu-van">Đăng ký tư vấn xếp lớp miễn phí</a></li>
          <li><a href="${pageContext.request.contextPath}/login">Đăng nhập cổng học tập cá nhân</a></li>
          <li><a href="${pageContext.request.contextPath}/register">Đăng ký thành viên mới</a></li>
        </ul>
      </div>

      <!-- Col 3 -->
      <div class="site-footer-nav-col">
        <h3>
          <svg class="icon icon-sm text-primary" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Về EduCenter
        </h3>
        <ul>
          <li><a href="${pageContext.request.contextPath}/#doi-ngu">Đội ngũ giáo viên chuyên môn</a></li>
          <li><a href="${pageContext.request.contextPath}/#thanh-tuu">Bảng vàng thành tựu &amp; Điểm số</a></li>
          <li><a href="${pageContext.request.contextPath}/#quy-trinh">Quy trình đăng ký &amp; Kiểm tra đầu vào</a></li>
          <li><a href="${pageContext.request.contextPath}/#chuong-trinh">Ngân hàng đề thi phân hóa 10.000+ câu</a></li>
          <li><a href="${pageContext.request.contextPath}/#faq">Câu hỏi thường gặp (FAQ)</a></li>
        </ul>
      </div>

      <!-- Col 4 -->
      <div class="site-footer-nav-col">
        <h3>
          <svg class="icon icon-sm text-primary" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Hỗ trợ &amp; Pháp lý
        </h3>
        <ul>
          <li><a href="${pageContext.request.contextPath}/#">Quy chế đào tạo &amp; Đánh giá định kỳ</a></li>
          <li><a href="${pageContext.request.contextPath}/#">Chính sách bảo mật dữ liệu học tập</a></li>
          <li><a href="${pageContext.request.contextPath}/#">Quy định hoàn trả học phí &amp; Bảo lưu</a></li>
          <li><a href="${pageContext.request.contextPath}/login">Cổng xác thực &amp; Tài khoản</a></li>
          <li><a href="${pageContext.request.contextPath}/forgot-password">Khôi phục mật khẩu tài khoản</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="site-footer-bottom-bar">
      <div>
        &copy; <c:out value="${currentYear != null ? currentYear : '2026'}"/> EduCenter ERP Platform. Bản quyền thuộc về Trung tâm Đào tạo EduCenter.
      </div>
      <div class="site-footer-uptime-pill">
        <span class="site-footer-uptime-dot"></span>
        <span>Cụm máy chủ EduCenter: Hoạt động bình thường (99.98% Uptime)</span>
      </div>
      <div class="site-footer-bottom-links">
        <a href="${pageContext.request.contextPath}/#">Quy chế đào tạo</a>
        <a href="${pageContext.request.contextPath}/#">Chính sách bảo mật</a>
        <a href="${pageContext.request.contextPath}/#">Hỗ trợ kỹ thuật</a>
      </div>
    </div>
  </div>
</footer>
