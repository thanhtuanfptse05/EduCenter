<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<footer class="site-footer" id="lien-he">
 <div class="site-footer-inner">
  <div class="site-footer-grid">
   <c:if test="${referenceDataUnavailable}"><p role="status">Chưa tải được dữ liệu danh mục và liên hệ. Vui lòng thử lại sau.</p></c:if>
   <div><h2>EduCenter</h2><p>Gia sư, bồi dưỡng kiến thức và luyện thi. Tìm chương trình phù hợp và gửi nhu cầu để được tư vấn.</p>
    <c:if test="${not empty contactAddress}"><p><c:out value="${contactAddress}"/></p></c:if>
    <c:if test="${not empty contactPhone}"><p>Điện thoại: <c:out value="${contactPhone}"/></p></c:if>
    <c:if test="${not empty contactEmail}"><p>Email: <c:out value="${contactEmail}"/></p></c:if>
   </div>
   <div><h3>Khám phá</h3><a href="${pageContext.request.contextPath}/courses">Danh mục khóa học</a><a href="${pageContext.request.contextPath}/#chuong-trinh">Chương trình học</a><a href="${pageContext.request.contextPath}/#doi-ngu">Đội ngũ giáo viên</a><a href="${pageContext.request.contextPath}/registration-cart">Danh sách đăng ký</a></div>
   <div><h3>Hỗ trợ</h3><a href="${pageContext.request.contextPath}/#dang-ky-tu-van">Gửi yêu cầu tư vấn</a><a href="${pageContext.request.contextPath}/#quy-trinh">Quy trình đăng ký</a><a href="${pageContext.request.contextPath}/#faq">Câu hỏi thường gặp</a><a href="${pageContext.request.contextPath}/login">Đăng nhập tài khoản</a></div>
  </div>
  <div class="site-footer-bottom">&copy; <c:out value="${currentYear}"/> EduCenter.</div>
 </div>
</footer>
