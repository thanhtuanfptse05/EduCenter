<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<aside class="admin-sidebar" id="app-sidebar">
    <div class="sidebar-brand">
        <span style="display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; background: var(--primary); color: #FFF; border-radius: var(--radius-sm);">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
        </span>
        <span>EduCenter</span>
    </div>

    <nav class="sidebar-nav">
        <!-- 1. Tổng quan -->
        <div class="nav-group-title">Tổng quan</div>
        <a href="${pageContext.request.contextPath}${sessionScope.currentUser.defaultDashboardUrl}" class="nav-link ${activeNav == 'dashboard' ? 'active' : ''}">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                <rect width="7" height="5" x="3" y="16" rx="1"></rect>
            </svg>
            <span>Bảng điều khiển</span>
        </a>

        <!-- 2. Quản trị Đào tạo & Hệ thống (Chỉ Admin & Quản lý trung tâm) -->
        <c:if test="${sessionScope.currentUser != null and sessionScope.currentUser.admin}">
            <div class="nav-group-title">Học vụ & Đào tạo</div>
            <a href="${pageContext.request.contextPath}/admin/courses" class="nav-link ${activeNav == 'courses' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                    <path d="M6 6h10"></path>
                    <path d="M6 10h10"></path>
                </svg>
                <span>Chương trình & Khóa học</span>
            </a>
            <a href="${pageContext.request.contextPath}/admin/subjects" class="nav-link ${activeNav == 'subjects' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m16 6 4 14"></path>
                    <path d="M12 6v14"></path>
                    <path d="M8 8v12"></path>
                    <path d="M4 4v16"></path>
                </svg>
                <span>Danh mục Môn học</span>
            </a>
            <a href="${pageContext.request.contextPath}/admin/teachers" class="nav-link ${activeNav == 'teachers' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Đội ngũ Giáo viên</span>
            </a>
            <a href="${pageContext.request.contextPath}/admin/classes" class="nav-link ${activeNav == 'classes' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Lớp học & Lịch giảng dạy</span>
            </a>
            <a href="${pageContext.request.contextPath}/admin/timetable" class="nav-link ${activeNav == 'timetable' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>Thời khóa biểu tuần</span>
            </a>
            <a href="${pageContext.request.contextPath}/admin/rooms" class="nav-link ${activeNav == 'rooms' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Quản lý Phòng học</span>
            </a>

            <div class="nav-group-title">Quản trị Hệ thống</div>
            <a href="${pageContext.request.contextPath}/admin/users" class="nav-link ${activeNav == 'users' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <polyline points="16 11 18 13 22 9"></polyline>
                </svg>
                <span>Quản lý người dùng & Vai trò</span>
            </a>
            <a href="${pageContext.request.contextPath}/admin/settings" class="nav-link ${activeNav == 'settings' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <span>Cấu hình hệ thống & Tham số</span>
            </a>
        </c:if>

        <!-- 3. Tuyển sinh & CRM (Dành cho Staff & Admin) -->
        <c:if test="${sessionScope.currentUser != null and (sessionScope.currentUser.staff or sessionScope.currentUser.admin)}">
            <div class="nav-group-title">Tuyển sinh & Khách hàng</div>
            <a href="${pageContext.request.contextPath}/staff/leads" class="nav-link ${activeNav == 'leads' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>Tư vấn Tuyển sinh (CRM)</span>
            </a>
            <%-- Tra cứu Lớp & Sĩ số và Thời khóa biểu Tuyển sinh là màn hình rút gọn cho Staff. Admin đã có ở mục Học vụ & Đào tạo nên không hiển thị tránh trùng lặp --%>
            <c:if test="${sessionScope.currentUser.staff and not sessionScope.currentUser.admin}">
                <a href="${pageContext.request.contextPath}/staff/classes" class="nav-link ${activeNav == 'staff-classes' ? 'active' : ''}">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>Tra cứu Lớp & Sĩ số</span>
                </a>
                <a href="${pageContext.request.contextPath}/staff/timetable" class="nav-link ${activeNav == 'staff-timetable' ? 'active' : ''}">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Thời khóa biểu Tuyển sinh</span>
                </a>
            </c:if>
            <a href="${pageContext.request.contextPath}/staff/students" class="nav-link ${activeNav == 'students' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Hồ sơ Học viên</span>
            </a>
            <a href="${pageContext.request.contextPath}/staff/guardians" class="nav-link ${activeNav == 'guardians' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Phụ huynh & Giám hộ</span>
            </a>
            <a href="${pageContext.request.contextPath}/staff/enrollments" class="nav-link ${activeNav == 'enrollments' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <polyline points="16 11 18 13 22 9"></polyline>
                </svg>
                <span>Ghi danh & Xếp lớp</span>
            </a>
            <a href="${pageContext.request.contextPath}/staff/invoices" class="nav-link ${activeNav == 'invoices' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                    <line x1="2" x2="22" y1="10" y2="10"></line>
                </svg>
                <span>Học phí & Hóa đơn</span>
            </a>
        </c:if>

        <!-- 3a. Giảng dạy (Teacher) -->
        <c:if test="${sessionScope.currentUser != null and (sessionScope.currentUser.teacher or sessionScope.currentUser.admin)}">
            <div class="nav-group-title">Giảng dạy & Học vụ</div>
            <a href="${pageContext.request.contextPath}/teacher/attendance" class="nav-link ${activeNav == 'attendance' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <polyline points="9 11 12 14 22 4"></polyline>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span>Điểm danh & Sổ đầu bài</span>
            </a>
            <a href="${pageContext.request.contextPath}/teacher/assessments" class="nav-link ${activeNav == 'assessments' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Bài kiểm tra & Bảng điểm</span>
            </a>
        </c:if>

        <!-- 3b. Cổng học tập dành cho Học viên (Student) -->
        <c:if test="${sessionScope.currentUser != null and sessionScope.currentUser.student}">
            <div class="nav-group-title">Học tập của tôi</div>
            <a href="${pageContext.request.contextPath}/student/dashboard" class="nav-link ${activeNav == 'student-dashboard' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                    <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                    <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                    <rect width="7" height="5" x="3" y="16" rx="1"></rect>
                </svg>
                <span>Tổng quan học tập</span>
            </a>
            <a href="${pageContext.request.contextPath}/student/schedule" class="nav-link ${activeNav == 'student-schedule' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>Thời khóa biểu & Ca học</span>
            </a>
            <a href="${pageContext.request.contextPath}/student/progress" class="nav-link ${activeNav == 'student-progress' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <span>Điểm số & Chuyên cần</span>
            </a>
        </c:if>

        <!-- 3c. Cổng giám sát dành cho Phụ huynh (Parent) -->
        <c:if test="${sessionScope.currentUser != null and sessionScope.currentUser.parent}">
            <div class="nav-group-title">Giám sát con học</div>
            <a href="${pageContext.request.contextPath}/parent/dashboard" class="nav-link ${activeNav == 'parent-dashboard' ? 'active' : ''}">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
                <span>Tiến độ & Kết quả của con</span>
            </a>
        </c:if>

        <!-- 4. Cá nhân -->
        <div class="nav-group-title">Cá nhân</div>
        <a href="${pageContext.request.contextPath}/profile" class="nav-link ${activeNav == 'profile' ? 'active' : ''}">
            <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Hồ sơ & Đổi mật khẩu</span>
        </a>
    </nav>
</aside>

<script>
/**
 * Tự động kích hoạt trạng thái Active cho liên kết Sidebar khớp với URL hiện tại.
 * Đảm bảo liên kết luôn sáng đèn chính xác dù ở trang danh sách, chi tiết hay tạo mới.
 */
document.addEventListener('DOMContentLoaded', function() {
    var curPath = window.location.pathname;
    var navLinks = document.querySelectorAll('#app-sidebar .sidebar-nav .nav-link');
    var matchedLink = null;
    var maxMatchLen = 0;

    navLinks.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href || href === '#' || href.indexOf('javascript:') === 0) return;

        try {
            var urlObj = new URL(link.href, window.location.origin);
            var linkPath = urlObj.pathname;

            // Khớp chính xác hoàn toàn
            if (curPath === linkPath) {
                if (linkPath.length >= maxMatchLen) {
                    maxMatchLen = linkPath.length + 1000;
                    matchedLink = link;
                }
            } 
            // Khớp tiền tố (ví dụ: /admin/classes/create hay /admin/classes/edit thuộc /admin/classes)
            else if (linkPath !== '${pageContext.request.contextPath}/' && curPath.indexOf(linkPath) === 0) {
                if (linkPath.length > maxMatchLen) {
                    maxMatchLen = linkPath.length;
                    matchedLink = link;
                }
            }
        } catch (e) {}
    });

    if (matchedLink) {
        navLinks.forEach(function(l) { l.classList.remove('active'); });
        matchedLink.classList.add('active');
    }
});
</script>
