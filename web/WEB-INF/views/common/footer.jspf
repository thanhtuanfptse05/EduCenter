<c:choose><c:when test="${internalShell}">
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<c:if test="${empty hideStandardFooter}">
    <footer class="app-footer">
        <div class="app-footer-container">
            <div class="app-footer-copyright">
                &copy; ${currentYear} EduCenter. Gia sư & Luyện thi lớp 6–12.
            </div>
            <div class="app-footer-links">
                <a href="${pageContext.request.contextPath}/" class="app-footer-link">Trang chủ</a>
                <span class="app-footer-sep">•</span>
                <a href="${pageContext.request.contextPath}/#chuong-trinh" class="app-footer-link">Chương trình gia sư</a>
                <span class="app-footer-sep">•</span>
                <a href="${pageContext.request.contextPath}/#faq" class="app-footer-link">Câu hỏi thường gặp</a>
                <span class="app-footer-sep">•</span>
                <a href="${pageContext.request.contextPath}/#dang-ky-tu-van" class="app-footer-link">Hỗ trợ kỹ thuật</a>
            </div>
        </div>
    </footer>
</c:if>






</c:when><c:otherwise><%@ include file="/WEB-INF/views/common/public-footer.jspf" %></c:otherwise></c:choose>
